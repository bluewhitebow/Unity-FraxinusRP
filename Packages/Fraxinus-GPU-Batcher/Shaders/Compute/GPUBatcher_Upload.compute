#pragma kernel ScatterWriteColors
#pragma kernel ScatterWriteSigOverrides
#pragma kernel ScatterWriteSignatures

// floating origin shift
#pragma kernel ShiftAllInstances
#pragma kernel ShiftAllChunks

// animated crossfade kernels

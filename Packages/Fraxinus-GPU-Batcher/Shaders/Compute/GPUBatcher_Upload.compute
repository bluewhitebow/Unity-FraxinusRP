// buffer upload + copy kernels
#pragma kernel CopyBufferRegion
#pragma kernel CopyChunkRegion
#pragma kernel CopyFadeStateRegion
#pragma kernel ScatterWriteChunks
#pragma kernel SettleMotionVectors

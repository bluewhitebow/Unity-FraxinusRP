// HZB construction kernels

#pragma use_dxc vulkan metal

#if UNITY_VERSION >= 600000
#pragma only_renderers d3d11 vulkan metal webgpu playstation xboxseries switch
#else
#pragma only_renderers d3d11 vulkan metal playstation xboxseries switch
#endif

#pragma kernel HZBDownscaleSPD
#pragma kernel HZBDownscaleTail
#pragma kernel HZBResolveMSAA2D
#pragma kernel HZBResolveMSAAArray


#pragma multi_compile_local _ HZB_SOURCE_TEXARRAY

#include "GPUBatcher_Common.hlsl"
#include "GPUBatcher_HZB.hlsl"


// HZB downscale: normalize device depth before reducing the canonical atlas.

// HDRP uses Texture2DArray for depth; URP uses Texture2D
#ifdef HZB_SOURCE_TEXARRAY
Texture2DArray<float> _HZBSource;
SamplerState          sampler_HZBSource;
#define GATHER_HZB_SOURCE(uv) _HZBSource.GatherRed(sampler_HZBSource, float3(uv, 0))
#else
Texture2D<float>      _HZBSource;
SamplerState          sampler_HZBSource;
#define GATHER_HZB_SOURCE(uv) _HZBSource.GatherRed(sampler_HZBSource, uv)
#endif

RWTexture2D<float> _HZBMipOut;

// single-pass downsampler, SPD pattern.
// mips 0-4: each 16x16 workgroup reduces its tile via groupshared.
// mips 5+: handled by tail kernel (separate dispatch).

#define SPD_TILE 16
#if defined(SHADER_API_VULKAN) && (defined(UNITY_PLATFORM_ANDROID) || defined(SHADER_API_MOBILE))
#define SPD_GROUP_Y 8
#else
#define SPD_GROUP_Y SPD_TILE
#endif

groupshared float s_spd[SPD_TILE * SPD_TILE];

[numthreads(SPD_TILE, SPD_GROUP_Y, 1)]
void HZBDownscaleSPD(uint3 groupId : SV_GroupID, uint3 lid : SV_GroupThreadID)
{
    uint sourceWidth, sourceHeight;
#ifdef HZB_SOURCE_TEXARRAY
    uint sourceSlices;
    _HZBSource.GetDimensions(sourceWidth, sourceHeight, sourceSlices);
#else
    _HZBSource.GetDimensions(sourceWidth, sourceHeight);
#endif
    // Use the actual allocation size under dynamic resolution.
    float2 invSrcSize = 1.0 / float2(sourceWidth, sourceHeight);
    int4 bounds = _OccluderMipBounds[0];

    // Both variants fill the same logical tile. Mobile lanes cover two rows.
    [unroll] for (uint y = lid.y; y < SPD_TILE; y += SPD_GROUP_Y)
    {
        uint2 mip0Coord = groupId.xy * SPD_TILE + uint2(lid.x, y);
        uint2 srcBase = min(mip0Coord, uint2(bounds.zw) - 1) * 8;
        float d = 1.0;
        [unroll] for (uint gy = 0; gy < 4; gy++)
        [unroll] for (uint gx = 0; gx < 4; gx++)
        {
            float2 uv = (float2(srcBase) + float2(gx * 2 + 1, gy * 2 + 1)) * invSrcSize;
            float4 g = HZBCanonicalDepth(GATHER_HZB_SOURCE(uv));
            d = min(d, min(min(g.x, g.y), min(g.z, g.w)));
        }
        s_spd[y * SPD_TILE + lid.x] = d;
        if (mip0Coord.x < (uint)bounds.z && mip0Coord.y < (uint)bounds.w)
            _HZBMipOut[mip0Coord + uint2(bounds.xy)] = d;
    }

    // Reduce disjoint 2x2 blocks into their own top-left cells. This avoids
    // overwriting another subgroup's input before that subgroup has read it.
    [unroll] for (uint mip = 1; mip <= 4; ++mip)
    {
        GroupMemoryBarrierWithGroupSync();
        uint blockSize = 1u << mip;
        uint tileSize = SPD_TILE / blockSize;
        if (lid.x < tileSize && lid.y < tileSize)
        {
            uint cell = (lid.y * SPD_TILE + lid.x) * blockSize;
            uint step = blockSize / 2;
            uint row = step * SPD_TILE;
            float d = min(min(s_spd[cell], s_spd[cell + step]),
                          min(s_spd[cell + row], s_spd[cell + row + step]));
            s_spd[cell] = d;

            int4 dstBounds = _OccluderMipBounds[mip];
            uint2 coord = groupId.xy * tileSize + lid.xy;
            if (coord.x < (uint)dstBounds.z && coord.y < (uint)dstBounds.w)
                _HZBMipOut[coord + uint2(dstBounds.xy)] = d;
        }
    }
}

// Resolve all samples to the farthest device depth before pyramid construction.
// An uncovered sample must keep the pixel visible; using the nearest sample here
// would make thin MSAA edges incorrectly occlude complete instances.
Texture2DMS<float> _HZBSourceMSAA;
Texture2DMSArray<float> _HZBSourceMSAAArray;
RWTexture2D<float> _HZBResolvedDepth;
int _HZBSourceSlice;

float HZBDeviceDepth(float canonicalDepth)
{
    return _HZBDepthConvention.x > 0.5 ? canonicalDepth : 1.0 - canonicalDepth;
}

[numthreads(8, 8, 1)]
void HZBResolveMSAA2D(uint3 id : SV_DispatchThreadID)
{
    uint width, height, samples;
    _HZBSourceMSAA.GetDimensions(width, height, samples);
    if (id.x >= width || id.y >= height) return;
    float depth = 1.0;
    for (uint sampleIndex = 0; sampleIndex < samples; ++sampleIndex)
        depth = min(depth, HZBCanonicalDepth(_HZBSourceMSAA.Load(id.xy, sampleIndex)));
    _HZBResolvedDepth[id.xy] = HZBDeviceDepth(depth);
}

[numthreads(8, 8, 1)]
void HZBResolveMSAAArray(uint3 id : SV_DispatchThreadID)
{
    uint width, height, slices, samples;
    _HZBSourceMSAAArray.GetDimensions(width, height, slices, samples);
    if (id.x >= width || id.y >= height || (uint)_HZBSourceSlice >= slices) return;
    float depth = 1.0;
    for (uint sampleIndex = 0; sampleIndex < samples; ++sampleIndex)
        depth = min(depth, HZBCanonicalDepth(_HZBSourceMSAAArray.Load(int3(id.xy, _HZBSourceSlice), sampleIndex)));
    _HZBResolvedDepth[id.xy] = HZBDeviceDepth(depth);
}


// tail kernel: reduces mips 5+ via sequential UAV reads (one dispatch, one workgroup)

int _HZBTailStartMip;
int _HZBTailMipCount;

#define HZB_TAIL_THREADS 64

[numthreads(HZB_TAIL_THREADS, 1, 1)]
void HZBDownscaleTail(uint3 lid : SV_GroupThreadID)
{
    for (int mip = _HZBTailStartMip; mip < _HZBTailMipCount; mip++)
    {
        int4 src = _OccluderMipBounds[mip - 1];
        int4 dst = _OccluderMipBounds[mip];
        uint totalPixels = (uint)(dst.z * dst.w);

        for (uint i = lid.x; i < totalPixels; i += HZB_TAIL_THREADS)
        {
            uint2 dstCoord = uint2(i % (uint)dst.z, i / (uint)dst.z);
            uint2 srcBase = dstCoord * 2 + uint2(src.xy);
            uint2 srcMax = uint2(src.x + src.z - 1, src.y + src.w - 1);

            uint2 c00 = srcBase;
            uint2 c10 = uint2(min(srcBase.x + 1, srcMax.x), srcBase.y);
            uint2 c01 = uint2(srcBase.x, min(srcBase.y + 1, srcMax.y));
            uint2 c11 = uint2(min(srcBase.x + 1, srcMax.x), min(srcBase.y + 1, srcMax.y));

            float d = HZBFarthestDepth(float4(
                _HZBMipOut[c00], _HZBMipOut[c10],
                _HZBMipOut[c01], _HZBMipOut[c11]));

            _HZBMipOut[dstCoord + uint2(dst.xy)] = d;
        }

        AllMemoryBarrierWithGroupSync();
    }
}

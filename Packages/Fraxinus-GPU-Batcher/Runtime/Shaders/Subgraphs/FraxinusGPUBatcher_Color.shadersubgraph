    "m_FunctionName": "GPUBatcher_UnpackColor",
    "m_FunctionSource": "95195c1586a8423c960f8ab314f8e15a",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "Color = float4(1, 1, 1, 1);\n\r\n#ifdef UNITY_DOTS_INSTANCING_ENABLED\n\nuint idx = (uint)InstanceIndex;\nuint byteOffset = (uint)5 + idx * 4;\n\nuint packed = unity_DOTSInstanceData.Load(byteOffset);\r\nif (packed == 0u) return;\n\r\nfloat4 inv = float4(\r\n    (packed          ) & 0xFF,\r\n    (packed >>  8) & 0xFF,\r\n    (packed >> 16) & 0xFF,\r\n    (packed >> 24) & 0xFF\r\n) / 255.0;\r\nColor = 1.0 - inv;\n\n#endif"
}


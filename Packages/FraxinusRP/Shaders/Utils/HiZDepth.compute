#pragma kernel CopyDepth
#pragma kernel ReduceDepth

Texture2D<float> _HiZSource;
RWTexture2D<float> _HiZOutput;
uint _HiZSourceWidth;
uint _HiZSourceHeight;
uint _HiZOutputWidth;
uint _HiZOutputHeight;
uint _HiZInvertDepth;

[numthreads(8, 8, 1)]
void CopyDepth(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _HiZOutputWidth || id.y >= _HiZOutputHeight)
        return;
    float depth = _HiZSource.Load(int3(id.xy, 0));
    _HiZOutput[id.xy] = _HiZInvertDepth != 0 ? 1.0 - depth : depth;
}

[numthreads(8, 8, 1)]
void ReduceDepth(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _HiZOutputWidth || id.y >= _HiZOutputHeight)
        return;

    uint2 sourceSize = uint2(_HiZSourceWidth, _HiZSourceHeight);
    uint2 outputSize = uint2(_HiZOutputWidth, _HiZOutputHeight);
    // Use the full normalized-UV footprint. With odd dimensions, adjacent
    // footprints overlap one source texel so no edge or boundary is omitted.
    uint2 begin = id.xy * sourceSize / outputSize;
    uint2 end = ((id.xy + 1) * sourceSize + outputSize - 1) / outputSize;
    float depth = 1.0;
    for (uint y = begin.y; y < end.y; ++y)
        for (uint x = begin.x; x < end.x; ++x)
            depth = min(depth, _HiZSource.Load(int3(x, y, 0)));
    _HiZOutput[id.xy] = depth;
}
